precision highp float;

#define VS_POSITION
#define WATER_REFLECT
#define SSR

// Водная гладь замка (меши water_3_* у адорнийцев) с отражением неба. От shader_pos отличается
// только этим блоком: та же планарная разметка (без VS_UV убер-шейдер берёт uv из vertPosition.xy),
// та же аддитивная подложка.
//
// SSR — трассировка по G-buffer отложенного освещения (блок в shader.fs.glsl): отражения
// зданий, скал и ночных огней. Работает только там, где кадр шёл в G-buffer; при отсутствии
// данных (небо, прозрачные объекты, выход луча за кадр/за дистанцию) отражение остаётся
// процедурным небом skyTint() — то есть ровно тем, что рисовалось до SSR.
//
// precision — highp: отражение считается по мировой позиции фрагмента (~1400…5200 ед.), в mediump
// направление разворота дрожит и звёзды в воде «кипят».
//
// varying объявлен здесь: defines-файл подставляется в начало обеих программ.
varying vec3 fragWorldPos;
