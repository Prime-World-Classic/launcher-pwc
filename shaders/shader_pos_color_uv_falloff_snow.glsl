precision highp float;

#define VS_POSITION
#define VS_COLOR
#define VS_UV
#define SNOW

// Погодный fullscreen-оверлей замка (CastleWeather, меши weather_*.bin, рисуются в прозрачном
// проходе поверх всей сцены).
//
// Глубина кадра задана СЛОЯМИ: у ближнего слоя редкие крупные снежинки и быстрое падение, у
// дальнего — частые мелкие и медленное. Все размеры и скорости — в МИРОВЫХ метрах: частица
// радиусом 2 см остаётся 2 см, а на экране она `size/(2*z*tan(fov/2))` высот экрана, то есть
// и зум, и дистанция слоя работают сами.
//
// Осадок — ОДНА МИРОВАЯ ТРЁХМЕРНАЯ РЕШЁТКА капель, а не плёнка, нарисованная на камере. Для
// фрагмента берётся мировая точка слоя (луч × дистанция слоя), из неё вычитается пройденный
// каплями путь `F*travel` — и уже это число есть номер ячейки. Отсюда и всё поведение «по
// миру»: капля, летящая вдоль луча зрения, уезжает в ГЛУБИНУ кадра, а не скользит по экрану;
// поле осадок сходится к точке схода мировых вертикалей (у камеры, смотрящей вниз, у верхнего
// края кадра капли бегут быстро, у нижнего — почти стоят); пан и поворот камеры не тащат узор
// за собой, потому что решётка привязана к миру, а не к осям вида.
//
// Координата узора — мировая и считается ОТ КАМЕРЫ (varying fragPlaneOff — метры точки квада
// от оси зрения, plus мировые оси плоскости fragCamR/U/F). Абсолютные мировые координаты
// (~1400 ед.) из вершинной программы не вычитаются: ошибка 1e-4 м на каждую панораму
// превращается в ~15 px скольжения узора на дальних слоях (масштаб z/D).
//
// Направление и скорость падения — мировая скорость капли (0,-1,0) плюс ветер, спроецированная
// на базис плоскости квада БЕЗ нормализации: её длина = sin угла между осью зрения и «мировым
// вниз», то есть доля падения, приходящаяся на экран. При обходе замка наклон то уходит в «+x»
// экрана, то в «-x», как и должно быть у настоящего ветра.
//
// Дождь — тот же шейдер с другими числами: скорость, длина хвоста (weather.y), радиус
// (weather2.x), наклон, цвет и прозрачность. Отдельного «режима» нет — капсула вдоль
// направления падения при нулевом хвосте сама вырождается в круг.
//
// ТОЛЩИНА СРЕЗА (weather3.z = `samples`). Слой — не объём, а плоскость, и капля рисуется, пока
// её образ попадает в ячейку решётки, в которой он живёт: сечение луча этой ячейкой по глубине
// ≈ одна ячейка. При 9 м/с и наклоне камеры вниз капля проходит её за ~1,3 кадра — узор на 80%
// пересобирается каждый кадр, глаз читает это как шум («капли слишком быстро спавнятся и
// гаснут»), а не как дождь. Поэтому внутри слоя луч фрагмента опрашивается НЕ в одной точке, а в
// `samples` точках, разнесённых на шаг ячейки вдоль луча: слой становится плитой толщиной в
// `samples` ячеек, капля живёт во столько же раз дольше, частота её появления падает так же,
// а на границах плиты она гаснёт плавным фейдом. samples = 1 — прежнее поведение (снег).
// Второе плечо той же регулировки — `weather3.w`: плотность решётки по мировой вертикали
// (она же направление падения) может быть НИЖЕ горизонтальной, т.е. ячейка растянута вдоль
// падения — жизнь капли растёт без лишних выборок.
//
// ФАЗА ПАДЕНИЯ: CastleWeather копит путь падения (travel, метры) и переводит его в мировую
// координату решётки под камерой — целую часть в weather5, дробную в weather6. Копить надо
// именно путь, а не «скорость × время сцены»: при смене скорости или fov произведение дало бы
// скачок узора на тысячи ячеек (визуально — «быстрая перемотка»). Делить путь на ячейки нужно
// в JS (float64): в float32 произведение на десятках километров теряет долю ячейки.
//
// Вызывается из shader.fs.glsl: snow(FRAG_COLOR, fragTexCoord, tintColor).
// tintColor передаётся параметром, а не читается как uniform: этот файл подставляется В НАЧАЛО
// и фрагментной, и вершинной программы (Castle.startProgram).

uniform vec4 weather; // x: накопленный путь падения, м — в шейдер он пришёл уже пересчитанным в координату решётки (weather5/weather6), здесь только y…w; y: длина хвоста, м; z: плотность (ячеек на метр); w: разброс размеров частиц
uniform vec4 weather2; // x: радиус частицы, м; y: дистанция ближнего слоя, м; z: дистанция дальнего слоя, м; w: расстояние от камеры до плоскости квада, м
uniform vec4 weather3; // x: число слоёв; y: множитель яркости дальнего слоя; z: выборок вдоль луча внутри слоя (толщина среза); w: множитель плотности решётки по мировой вертикали
uniform vec4 weather4; // xy: мировая скорость падения в базисе плоскости квада (НЕ единичная: её длина = доля падения, приходящаяся на экран); z: доля ячеек с частицей; w: составляющая вдоль луча зрения
uniform vec4 weather5; // xyz: ЦЕЛАЯ часть мировой координаты решётки, приходящейся на камеру с учётом пройденного пути: floor((camW - F*travel)*cell); w: резерв
uniform vec4 weather6; // xyz: ДРОБНАЯ часть того же числа; w: резерв
uniform vec2 uvScroll; // нужен убер-шейдеру (сэмпл текстуры до snow()); на сам эффект не влияет

varying vec2 fragPlaneOff; // метры точки квада от оси зрения по осям плоскости квада (пишет shader.vs.glsl)
varying vec3 fragCamR; // мировые оси: right/up плоскости квада и ось зрения — те же, из которых
varying vec3 fragCamU; // CastleWeather считает weather4, поэтому базис приходит из вершинной
varying vec3 fragCamF; // программы, а не отдельным uniform-ом

#define SNOW_MAX_LAYERS 8
// Выборок вдоль луча фрагмента внутри одного слоя. 1 = плоский срез (штатный режим снега),
// >1 = слой превращается в ПЛИТУ толщиной в `samples` ячеек решётки: капля живёт в кадре во
// `samples` раз дольше и узор не пересобирается каждый кадр.
#define SNOW_MAX_SLAB 4
// Номер мировой ячейки берётся по модулю: на длинной сессии (travel — десятки километров)
// аргумент sin() в хеше дорастает до 1e8 и float32 перестаёт различать соседние ячейки.
// 4096 ячеек при плотности 5.4 яч/м = 760 м, дальше решётки в кадр не попадают.
#define SNOW_CELL_MOD 4096.0

float hash3(vec3 p)
{
    return fract(sin(dot(p, vec3(12.9898, 78.233, 45.164))) * 43758.5453);
}

void snow(out vec4 outColor, in vec2 fragCoord, in vec4 tint)
{
    if (tint.a <= 0.0) { // фейд в ноль (CastleWeather) — не гонять цикл по всему кадру
        outColor = vec4(0.0);
        return;
    }

    float layers = clamp(weather3.x, 1.0, float(SNOW_MAX_LAYERS));
    float samples = clamp(weather3.z, 1.0, float(SNOW_MAX_SLAB)); // выборок вдоль луча в слое
    float zNearL = max(weather2.y, 0.05);
    float zFarL = max(weather2.z, zNearL * 1.01);
    float planeDist = max(weather2.w, 0.01);
    vec2 fall = weather4.xy; // мировая скорость падения в базисе квада; длина < 1 у «видящих вниз» камер
    float fallFwd = weather4.w; // и её доля, уходящая вдоль луча зрения (перспектива полос и глубина)
    float presence = clamp(weather4.z, 0.0, 1.0);
    float cell = max(weather.z, 0.01); // ячеек на метр по горизонтали — одинаково для всех слоёв
    // Плотность решётки по мировой вертикали (weather3.w) может ОТЛИЧАТЬСЯ от горизонтальной:
    // вертикаль — она же направление падения, поэтому растянутая по ней ячейка (меньше ячеек на
    // метр) удлиняет жизнь капли, не разжижая картину по горизонтали.
    vec3 cellV = vec3(cell, cell * max(weather3.w, 0.01), cell);

    vec3 eR = fragCamR;
    vec3 eU = fragCamU;
    vec3 eF = fragCamF;

    float cov = 0.0;

    // Шаг выборки вдоль луча = величина ячейки в этом направлении (сколько ячеек уходит на метр
    // луча — dot модулей). Плита слоя = `samples` таких шагов, центрирована на плоскости z.
    float slabStep = 1.0 / max(dot(abs(eF), cellV), 0.01);
    float slab = 0.5 * samples * slabStep;

    for (int i = 0; i < SNOW_MAX_LAYERS; i++)
    {
        float li = float(i);
        if (li >= layers) break;

        // дистанция слоя: k = 0 у ближнего, 1 у дальнего, между ними — геометрическая прогрессия
        float k = layers > 1.5 ? li / (layers - 1.0) : 0.0;
        float z = zNearL * pow(zFarL / zNearL, k);

        // Мировая точка слоя на том же луче, что и точка квада: плоскость слоя отстоит в z/D раз
        // дальше, и смещение берётся ОТ КАМЕРЫ (p, X), а не от начала мира.
        vec2 p = fragPlaneOff * (z / planeDist);
        float depthFade = mix(1.0, clamp(weather3.y, 0.0, 1.0), (z - zNearL) / (zFarL - zNearL));

        for (int j = 0; j < SNOW_MAX_SLAB; j++)
        {
            float lj = float(j);
            if (lj >= samples) break;

            // Точка выборки — на ЛУЧЕ ФРАГМЕНТА, но внутри плиты слоя (t = −1..1), а не только в
            // её плоскости. Иначе капля, отстоящая от плоскости дальше половины ячейки, теряет
            // свой образ вместе с ячейкой: срез выходит тоньше ячейки и осадок пересобирается
            // каждый кадр (у дождя 9 м/с это ~1,3 кадра жизни — «кипящий» шум).
            float t = (lj + 0.5) / samples * 2.0 - 1.0;
            float zj = z + t * slab;
            if (zj < 0.05) continue;
            vec2 pj = p * (zj / z);
            vec3 X = eR * pj.x + eU * pj.y + eF * zj; // метры от камеры до точки выборки, в мировых осях

            // Координата мировой решётки для точки, ОТКУДА капля пришла за накопленный путь:
            // (X + camW - F*travel)*cell, где F — мировая скорость капли (weather4 пересобрана из
            // неё в JS, поэтому это один и тот же вектор: фаза и след не разъезжаются). Камерное
            // слагаемое разложено JS на целую (weather5) и дробную (weather6) части: иначе при
            // длинной сессии дробная часть квантуется ценой ячейки и узор дрожит.
            vec3 q = X * cellV + weather6.xyz;
            vec3 gi = floor(q);
            vec3 seed = mod(gi + weather5.xyz, SNOW_CELL_MOD); // номер ячейки в мире — он же и сид
            if (hash3(seed) > presence) continue; // частица есть не в каждой ячейке

            vec3 off = vec3(hash3(seed * 1.31 + vec3(11.0, 3.0, 7.0)), hash3(seed * 2.17 + vec3(5.0, 17.0, 2.0)), hash3(seed * 3.11 + vec3(23.0, 9.0, 13.0)));
            // мировые метры от точки выборки до центра капли; капля лежит в этой же ячейке
            // решётки, поэтому смещение ограничено одной ячейкой и НИКОГДА не растёт с travel
            vec3 delta = (gi + off - q) / cellV;
            float dR = dot(delta, eR);
            float dU = dot(delta, eU);
            float dF = dot(delta, eF);
            float zp = zj + dF; // капля чуть ближе или дальше точки выборки — её образ в плоскости слоя
            if (zp < 0.05) continue; // капля за камерой
            float kk = z / zp;
            // образ капли в плоскости слоя, метры от фрагмента; при samples = 1 (zj = z, pj = p)
            // тождественен прежнему (vec2(dR, dU) - p * (dF / z)) * kk
            vec2 e = (vec2(dR, dU) + pj) * kk - p;

            float sizeVar = 1.0 + weather.w * (hash3(seed + vec3(71.0)) - 0.5);
            float rad = max(weather2.x * sizeVar * kk, 0.001);

            // Полоса следа — ИСТИННЫЙ образ мирового пути капли длиной weather.y: у точек,
            // удалённых от оси зрения, к плоскостной составляющей скорости добавляется
            // перспективная (мировые вертикали сходятся к точке схода), поэтому полосы веером,
            // короче там, где капля летит «вглубь кадра», и длиннее там, где поперёк.
            vec2 streak = fall - (pj + vec2(dR, dU)) * (fallFwd / zp);
            float streakLen = length(streak);
            float halfLen = max(weather.y * 0.5, 0.0) * min(streakLen, 1.5);
            vec2 sdir = streakLen > 1e-5 ? streak / streakLen : vec2(0.0, -1.0);

            // капсула вдоль направления следа: при halfLen = 0 вырождается в круг (снег)
            vec2 along = sdir * clamp(dot(e, sdir), -halfLen, halfLen);
            float a = smoothstep(rad, rad * 0.2, length(e - along));
            if (a <= 0.0) continue;

            // Капля входит в плиту и выходит из неё ПЛАВНО (0.6..1.0 — край плиты): иначе на
            // границе среза она вспыхивает точкой — тот же шум, только реже.
            a *= 1.0 - smoothstep(0.6, 1.0, abs(t));

            float bright = 0.55 + 0.45 * hash3(seed + vec3(13.0));
            cov = 1.0 - (1.0 - cov) * (1.0 - a * bright * depthFade * tint.a);
        }
    }

    outColor = vec4(tint.rgb, cov);
}
