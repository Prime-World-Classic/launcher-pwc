#define SKY_STARS

// Небо замка (меши sky_01…sky_06). От shader_pos_uv отличается тем, что к панораме подмешивается
// звёздное поле ночью, и тем, что precision поднят до highp: мировые координаты вершин неба —
// ~1400…5200 единиц, в mediump (10 бит мантиссы) направление на звезду дрожит на сотые доли
// градуса, и мерцание превращается в шум.
//
// varying объявлен здесь, а не в убер-шейдере: defines-файл подставляется В НАЧАЛО обеих
// программ (Castle.startProgram), поэтому и вершинная, и фрагментная видят одно и то же.
varying vec3 fragWorldPos;
